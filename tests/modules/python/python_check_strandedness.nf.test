nextflow_process {

    name "Test Process CHECK_STRANDEDNESS"
    script "modules/python/python_check_strandedness.nf"
    process "CHECK_STRANDEDNESS"

    test("Paired-end") {

        when {
            params {
                pipeline = 'rnaseq'
                pubdir = "tests/results"
                gen_org = "mouse"
                read_type = 'PE'
            }
            process {
                """
                input[0] = tuple('testSample_42', [file('https://raw.githubusercontent.com/TheJacksonLaboratory/jds-nf-test/main/rna/mouse/mm10_RNA_sample_R1.fastq.gz', checkIfExists: true), file('https://raw.githubusercontent.com/TheJacksonLaboratory/jds-nf-test/main/rna/mouse/mm10_RNA_sample_R2.fastq.gz', checkIfExists: true)])
                """
            }
        }

        then {
            assert process.success
        }

    }

    test("Single-end") {

        when {
            params {
                pipeline = 'rnaseq'
                pubdir = "tests/results"
                gen_org = "mouse"
                read_type = 'SE'
            }
            process {
                """
                input[0] = tuple('testSample_42', [file('https://raw.githubusercontent.com/TheJacksonLaboratory/jds-nf-test/main/rna/mouse/mm10_RNA_sample_R1.fastq.gz', checkIfExists: true)])
                """
            }
        }

        then {
            assert process.success
        }

    }

    test("gzipped-gtf") {

        when {
            params {
                pipeline = 'rnaseq'
                pubdir = "tests/results"
                gen_org = "mouse"
                read_type = 'PE'
                strandedness_gtf = 'https://raw.githubusercontent.com/TheJacksonLaboratory/jds-nf-test/main/rna/index/new.gtf.gz'
            }
            process {
                """
                input[0] = tuple('testSample_42', [file('https://raw.githubusercontent.com/TheJacksonLaboratory/jds-nf-test/main/rna/mouse/mm10_RNA_sample_R1.fastq.gz', checkIfExists: true), file('https://raw.githubusercontent.com/TheJacksonLaboratory/jds-nf-test/main/rna/mouse/mm10_RNA_sample_R2.fastq.gz', checkIfExists: true)])
                """
            }
        }

        then {
            assert process.success
        }

    }

}
