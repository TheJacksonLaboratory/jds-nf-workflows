nextflow_workflow {

    name "Test Workflow GENERATE_RNASEQ_SIMREADS"
    script "supportworkflows/generate_rnaseq_simreads.nf"
    workflow "GENERATE_RNASEQ_SIMREADS"

    test("Full Workflow -- GRCm38 -- PE") {

        when {
            params {
                gen_org = "mouse"
                pubdir = "tests/results"
                pipeline = 'generate_rnaseq_simreads'
                library_size = '10000, 20000'
            }
        }

        then {
            assert workflow.success
        }

    }

    test("Full Workflow -- GRCm38 -- SE") {

        when {
            params {
                gen_org = "mouse"
                pubdir = "tests/results"
                pipeline = 'generate_rnaseq_simreads'
                library_size = '10000, 20000'
                library_strategy = 'SE'
            }
        }

        then {
            assert workflow.success
        }

    }

    test("Full Workflow -- GRCm38 -- BOTH") {

        when {
            params {
                gen_org = "mouse"
                pubdir = "tests/results"
                pipeline = 'generate_rnaseq_simreads'
                library_size = '10000, 20000'
                library_strategy = 'BOTH'
            }
        }

        then {
            assert workflow.success
        }

    }

}
/*
  library_size = '1000000, 5000000'
  library_strategy = 'PE'
  read_length = 100
  fragment_length_min = 125
  fragment_length_max = 500
  fragment_length_mean = 250
  fragment_length_sd = 40
  simulate_sequencing_error = false
  quality_reference = ''
*/