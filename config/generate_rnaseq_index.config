//====================  Nextflow/Container Config  ==========

manifest {
    name = "generate_rnaseq_index"
    description = 'Pipeline for Generating RNASeq Index Files'
}

params {
  gen_org = params.gen_org ?: 'mouse'
  genome_build = params.genome_build ?: 'GRCm38'
  annotation_source = params.annotation_source ?: 'ensembl'
  star_read_lengths = '50, 75, 100, 125, 150'
  ref_fa = null
  ref_gtf = null
  ref_gff = null
  ref_gff3 = null
  mgi = null
  ref_table = null
  custom_gene_fasta = null

  reference_profiles = [
    mouse_grcm38: [
      gen_org: 'mouse',
      genome_build: 'GRCm38',
      annotation_source: 'ensembl',
      ref_fa: params.reference_cache+'/mouse/GRCm38/genome/sequence/ensembl/v102/Mus_musculus.GRCm38.dna.primary_assembly.fa',
      ref_gtf: params.reference_cache+'/mouse/GRCm38/transcriptome/annotation/ensembl/v102/Mus_musculus.GRCm38.102.gtf',
      ref_gff: null,
      ref_gff3: null,
      ref_table: null,
      custom_gene_fasta: null
    ],
    human_grch38: [
      gen_org: 'human',
      genome_build: 'GRCh38',
      annotation_source: 'ensembl',
      ref_fa: params.reference_cache+'/human/GRCh38/genome/sequence/ensembl/v104/Homo_sapiens.GRCh38.dna.primary_assembly.fa',
      ref_gtf: params.reference_cache+'/human/GRCh38/transcriptome/annotation/ensembl/v104/Homo_sapiens.GRCh38.104.gtf',
      ref_gff: null,
      ref_gff3: null,
      ref_table: null,
      custom_gene_fasta: null
    ],
    mouse_grcm39: [
      gen_org: 'mouse',
      genome_build: 'GRCm39',
      annotation_source: 'ensembl',
      ref_fa: params.reference_cache+'/mouse/GRCm39/genome/sequence/ensembl/v105/Mus_musculus.GRCm39.dna.primary_assembly.fa',
      ref_gtf: params.reference_cache+'/mouse/GRCm39/transcriptome/annotation/ensembl/v105/Mus_musculus.GRCm39.105.gtf',
      ref_gff: null,
      ref_gff3: null,
      ref_table: null,
      custom_gene_fasta: null
    ],
    mouse_mgi: [
      gen_org: 'mouse',
      genome_build: 'GRCm39',
      annotation_source: 'MGI',
      ref_fa: params.reference_cache+'/mouse/GRCm39/genome/sequence/ensembl/v114/Mus_musculus.GRCm39.dna.primary_assembly.fa',
      ref_gtf: null,
      ref_gff: null,
      ref_gff3: params.reference_cache+'/mouse/GRCm39/transcriptome/annotation/mgi/v114/MGI.gff3',
      ref_table: params.reference_cache+'/mouse/GRCm39/supporting_files/rnaseq/Mus_musculus.GRCm39.114.gene_id.name_biotype_mgi.txt',
      custom_gene_fasta: null
    ],
    other_user: [
      gen_org: 'other',
      genome_build: 'user_to_provide',
      annotation_source: null,
      ref_fa: null,
      ref_gtf: null,
      ref_gff: null,
      ref_gff3: null,
      ref_table: null,
      custom_gene_fasta: null
    ]
  ]

  selected_profile = params.gen_org == 'other' ? 'other_user' :
    (params.annotation_source == 'MGI' ? 'mouse_mgi' :
    ((params.gen_org == 'human' || params.genome_build == 'GRCh38') ? 'human_grch38' :
    (params.genome_build == 'GRCm39' ? 'mouse_grcm39' : 'mouse_grcm38')))

  selected_defaults = params.reference_profiles[params.selected_profile]
  gen_org = params.selected_defaults.gen_org
  genome_build = params.selected_defaults.genome_build
  annotation_source = params.selected_defaults.annotation_source
  ref_fa = params.selected_defaults.ref_fa
  ref_gtf = params.selected_defaults.ref_gtf
  ref_gff = params.selected_defaults.ref_gff
  ref_gff3 = params.selected_defaults.ref_gff3
  ref_table = params.selected_defaults.ref_table
  custom_gene_fasta = params.selected_defaults.custom_gene_fasta
}
