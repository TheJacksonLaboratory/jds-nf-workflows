//====================  Nextflow/Container Config  ==========

manifest {
    name = "generate_rnaseq_simreads"
    description = 'Pipeline for Generating RNASeq Simulated Reads'
}

params {
  gen_org = gen_org ?: 'mouse'
  genome_build = genome_build ?: 'GRCm38'
  annotation_source = annotation_source ?: 'ensembl'
  fa_cds = 'http://ftp.ensembl.org/pub/release-102/fasta/mus_musculus/cds/Mus_musculus.GRCm38.cds.all.fa.gz'
}

if (params.gen_org=='human' || params.genome_build=='GRCh38') {
  params.gen_org = 'human'
  params.genome_build = 'GRCh38'
  params.fa_cds = 'http://ftp.ensembl.org/pub/release-104/fasta/homo_sapiens/cds/Homo_sapiens.GRCh38.cds.all.fa.gz'
}


