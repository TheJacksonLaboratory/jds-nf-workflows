//====================  Nextflow/Container Config  ==========

manifest {
    name = "pta"
    description = 'Patient Tumor Analysis: Pipeline for processing of germline and somatic SNP/InDEL and somatic structural variants and copy number alterations.'
}

params {
    // PDX sample: 
    pdx = params.pdx ?: false

    // MT calling:
    run_mt_calling = params.run_mt_calling ?: false

    multiqc_config = "${projectDir}/bin/shared/multiqc/pta_multiqc.yaml"
    multiqc_config_mt = "${projectDir}/bin/shared/multiqc/mt_variant_calling.yaml"

    // Deduplicate reads
    deduplicate_reads = false

    // Split FASTQ prior to mapping
    split_fastq = false
    split_fastq_bin_size = 10000000

    // Apply Coverage Cap
    coverage_cap = null
    primary_chrom_bed = params.reference_cache+'/human/GRCh38/genome/annotation/intervals/Homo_sapiens_assembly38.primary_chrom.bed'

    // FASTP parameters
    quality_phred = 15 // default
    unqualified_perc = 40 // default
    detect_adapter_for_pe = false // by default, the auto-detection for adapter is for SE data input only, turn on this option to enable it for PE data.
    // NOTE: For PE data, the adapter sequence auto-detection is disabled by default since the adapters can be trimmed by overlap analysis. However, you can specify --detect_adapter_for_pe to enable it.
    //       For PE data, fastp will run a little slower if you specify the sequence adapters or enable adapter auto-detection, but usually result in a slightly cleaner output, since the overlap analysis may fail due to sequencing errors or adapter dimers.
    trim_poly_g = false
    trim_poly_x = false
    poly_x_min_len = 10
    
    // xengsort index  
    xengsort_host_fasta = params.reference_cache+'/mouse/GRCm39/genome/sequence/imputed/rel_2112_v8/NOD_ShiLtJ.39.fa'
    xengsort_idx_path = params.reference_cache+'/human/GRCh38/supporting_files/xengsort'
    xengsort_idx_name = 'hg38_GRCm39-NOD_ShiLtJ'

    // Reference fasta
    ref_fa = params.reference_cache+'/human/GRCh38/genome/sequence/gatk/Homo_sapiens_assembly38.fasta'
    ref_fa_indices = params.reference_cache+'/human/GRCh38/genome/indices/gatk/bwa/Homo_sapiens_assembly38.fasta'
    ref_fa_dict = params.reference_cache+'/human/GRCh38/genome/sequence/gatk/Homo_sapiens_assembly38.dict'
    combined_reference_set = params.reference_cache+'/human/GRCh38/supporting_files/PTA_inputs/combined_ref_set/Homo_sapiens_assembly38.fasta' // Several tools (GRIDSS, SVABA) requires reference and bwa index files in same directory. Links used within this directory to avoid duplication. See note in directory. 

    // BWA params
    mismatch_penalty = "8"

    // Known Sites for BQSR
    gold_std_indels = params.reference_cache+'/human/GRCh38/genome/annotation/snps_indels/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz' // used in variant recal, and variant tranche recal. GATK resource bundle. 
    phase1_1000G = params.reference_cache+'/human/GRCh38/genome/annotation/snps_indels/1000G_phase1.snps.high_confidence.hg38.vcf.gz' // used in variant recal, and variant tranche recal. GATK resource bundle. 
    dbSNP = params.reference_cache+'/human/GRCh38/genome/annotation/snps_indels/dbsnp_151.vcf.gz' // used in annotation, variant recal, variant tranche recal, and by SVABA. 
    dbSNP_index = params.reference_cache+'/human/GRCh38/genome/annotation/snps_indels/dbsnp_151.vcf.gz.tbi'

    // Chromosome contig lists, used in scatter / gather operations. 
    chrom_contigs = params.reference_cache+'/human/GRCh38/genome/sequence/gatk/Homo_sapiens_assembly38.primaryChr.contig_list' // Contig list used for scatter / gather in calling and annotation. 
    chrom_intervals = params.reference_cache+'/human/GRCh38/genome/annotation/intervals/hg38_calling_intervals/' // Chromosome intervals used for scatter gather in calling. 
    

    // Germline Haplotypecaller and downstream filtering. 
    call_val = 50.0
    ploidy_val = "2"
    excludeIntervalList = params.reference_cache+'/human/GRCh38/genome/annotation/intervals/hg38_haplotypeCaller_skip.interval_list' // Germline caller exclusion list. 
    hapmap = params.reference_cache+'/human/GRCh38/genome/annotation/snps_indels/hapmap_3.3.hg38.vcf.gz' // variant tranche requirement. GATK resource bundle. 
    omni = params.reference_cache+'/human/GRCh38/genome/annotation/snps_indels/1000G_omni2.5.hg38.vcf.gz' // variant tranche requirement. GATK resource bundle. 

    // Somatic SNP/InDEL filtering 
    pon_bed = params.reference_cache+'/human/GRCh38/supporting_files/PTA_inputs/filtering/WGS_1000g_GRCh38.pon.bed' // used in snp/indel filtering.
    intervalListBed=params.reference_cache+'/human/GRCh38/supporting_files/PTA_inputs/filtering/SureSelect_V6plusCOSMIC.target.GRCh38_full_analysis_set_plus_decoy_hla.interval_list.bed' // used to extract non-exonic regions, to attempt recovery with Lancet calls.

    // Lancet: 
    lancet_beds_directory = params.reference_cache+'/human/GRCh38/genome/annotation/intervals/lancet_chr_beds/' // Lancet requirement

    // Bicseq2 
    mappability_directory = params.reference_cache+'/human/GRCh38/genome/annotation/intervals/mappability' // Bicseq2 requirement. 
    bicseq2_chromList = params.reference_cache+'/human/GRCh38/supporting_files/PTA_inputs/configs/sampleId.bicseq2.config' // bicseq2 requirement
    bicseq2_no_scaling = false

    // Gridss and Gripss (filtering)
    gripss_pon = params.reference_cache+'/human/GRCh38/supporting_files/PTA_inputs/gripss_pon' // gripss requirement

    // Manta
    callRegions = params.reference_cache+'/human/GRCh38/genome/annotation/intervals/GRCh38.callregions.bed.gz' // manta requirement. 

    // Strelka
    strelka_config = params.reference_cache+'/human/GRCh38/supporting_files/PTA_inputs/configs/configureStrelkaSomaticWorkflow.py.ini' // strelka requirement.

    // MSIsensor2
    msisensor_model=params.reference_cache+'/human/GRCh38/supporting_files/msisensor2/models_hg38' // model files for MSIsensor2

    // Annotations: 
    // VEP
    vep_cache_directory = params.reference_cache+'/human/GRCh38/genome/annotation/vep_data' // VEP annotation cache. Note this directory contains additional annotation cache files. 
    vep_fasta = params.reference_cache+'/human/GRCh38/genome/sequence/ensembl/GRCh38.p13/Homo_sapiens.GRCh38.dna.primary_assembly.fa' // VEP is ensembl based, and requires a separate reference file. 

    // Cosmic.
    cosmic_cgc = params.reference_cache+'/human/GRCh38/genome/annotation/function/cancer_gene_census_v97.csv'
    cosmic_cancer_resistance_muts = params.reference_cache+'/human/GRCh38/genome/annotation/function/CosmicResistanceMutations.tsv.gz'

    // Additional somatic annotations
    ensembl_entrez=params.reference_cache+'/human/GRCh38/supporting_files/PTA_inputs/annotations/GRCh39.p13_ensemblv109_entrez_id_map.csv' // used in somatic vcf finalization.

    // CNV and SV annotations and filtering files. 
    germline_filtering_vcf = params.reference_cache+'/human/GRCh38/supporting_files/PTA_inputs/filtering/gnomad-and-ALL_GRCh38_sites.20170504.normalized.modified.PASS.vcf.gz' // used in SNV call filtering.
    cytoband = params.reference_cache+'/human/GRCh38/supporting_files/PTA_inputs/annotations/GRCh38.cytoBand.UCSC.chr.sorted.txt' // used in bicseq2 annotations
    dgv = params.reference_cache+'/human/GRCh38/supporting_files/PTA_inputs/annotations/DGV.GRCh38_hg38_variants_2020-02-25.bed' // used in bicseq2 annotations
    thousandG = params.reference_cache+'/human/GRCh38/supporting_files/PTA_inputs/annotations/1KGP.CNV.GRCh38.canvas.merged.bed' // used in bicseq2 annotations
    cosmicUniqueBed = params.reference_cache+'/human/GRCh38/supporting_files/PTA_inputs/annotations/CosmicCompleteCNA_uniqIntervals.bed' // used in bicseq2 annotations
    cancerCensusBed = params.reference_cache+'/human/GRCh38/supporting_files/PTA_inputs/annotations/cancer_gene_census.GRCh38-v92.bed' // used in bicseq2 annotations and SV annotation. 
    ensemblUniqueBed = params.reference_cache+'/human/GRCh38/supporting_files/PTA_inputs/annotations/ensembl_genes_unique_sorted.final.v93.chr.sorted.bed' // used in bicseq2 annotations and SV annotation.   
    gap = params.reference_cache+'/human/GRCh38/supporting_files/PTA_inputs/annotations/GRCh38.gap.UCSC.annotated.chr.sorted.bed' // used in SV annotation.
    dgvBedpe = params.reference_cache+'/human/GRCh38/supporting_files/PTA_inputs/annotations/DGV.GRCh38_hg38_variants_2020-02-25.bedpe' // used in SV annotation.
    thousandGVcf = params.reference_cache+'/human/GRCh38/supporting_files/PTA_inputs/annotations/1KGP.pruned_wAFs.PASS_and_MULTIALLELIC_Mosaic.GRCh38.vcf' // used in SV annotation.
    svPon = params.reference_cache+'/human/GRCh38/supporting_files/PTA_inputs/annotations/1000G-SV-PON.survivor-merged.GRCh38.filtered.bedpe' // used in SV annotation.
    cosmicBedPe = params.reference_cache+'/human/GRCh38/supporting_files/PTA_inputs/annotations/cosmic-sv-GRCh38-v92.bedpe' // used in SV annotation.

    // NA12878 BAM file. For use in tumor-only processing. 
    na12878_bam = params.reference_cache+'/human/GRCh38/supporting_files/PTA_inputs/NA12878/NA12878_realigned_BQSR.bam'
    na12878_bai = params.reference_cache+'/human/GRCh38/supporting_files/PTA_inputs/NA12878/NA12878_realigned_BQSR.bai'
    na12878_sampleName = 'NA12878'

    // General ngs-ops arguments unsed in this workflow. 
    read_type = 'PE' // Only PE accepted.
    gen_org = params.gen_org ?: 'human'
    genome_build = params.genome_build ?: 'GRCh38'
    sample_folder = null // not used, csv input required.
    extension='' // not used, csv input required. 
    pattern="" // not used, csv input required.
    concat_lanes = false // not used, csv input required.
    csv_input = null
    bwa_min_score = null

    // MT calling parameters:
    mt_contig_name = 'chrM'

    mt_fasta = params.reference_cache+'/human/GRCh38/genome/sequence/gatk/mtdna/Homo_sapiens_assembly38.MT.fasta'
    mt_genome = params.reference_cache+'/human/GRCh38/genome/sequence/gatk/Homo_sapiens_assembly38.genome'
    mt_shifted_fasta = params.reference_cache+'/human/GRCh38/genome/sequence/gatk/mtdna/Homo_sapiens_assembly38.MT.shifted8k.fasta'
    shift_back_chain = params.reference_cache+'/human/GRCh38/genome/sequence/gatk/mtdna/Homo_sapiens_assembly38.MT.shiftback'

    mt_fasta_index = params.reference_cache+'/human/GRCh38/genome/indices/gatk/bwa/Homo_sapiens_assembly38.MT'
    mt_shifted_fasta_index = params.reference_cache+'/human/GRCh38/genome/indices/gatk/bwa/Homo_sapiens_assembly38.MT.shifted8k'

    exclusion_sites = params.reference_cache+'/human/GRCh38/genome/annotation/intervals/blacklist_sites.hg38.chrM.bed'
    
    max_allele_count = 4

    // Mutserve Settings -- set to tool defaults.
    detection_limit = 0.01    
    mapQ = 20
    baseQ = 20

    non_control_region_interval_list = params.reference_cache+'/human/GRCh38/genome/annotation/intervals/non_control_region.chrM.interval_list'
    control_region_shifted_interval_list = params.reference_cache+'/human/GRCh38/genome/annotation/intervals/control_region_shifted.chrM.interval_list'

    // VCF annotation
    gen_ver = "hg38"
    dbNSFP=params.reference_cache+'/human/GRCh38/genome/annotation/function/dbNSFP4.2a.gatk_formatted.txt.gz'
    snpEff_config = params.reference_cache+'/human/GRCh38/genome/indices/snpEff_5_1/snpEff.config'
    cosmic = params.reference_cache+'/human/GRCh38/genome/annotation/function/COSMICv95_Coding_Noncoding.gatk_formatted.vcf.gz'
    cosmic_index = params.reference_cache+'/human/GRCh38/genome/annotation/function/COSMICv95_Coding_Noncoding.gatk_formatted.vcf.gz.tbi' 

    // HLA Typing
    params.hla_typing = true


    // mouse specific, but set here to avoid: "WARN: Access to undefined parameter..." message on startup.
    delly_exclusion = null
    delly_mappability = null
    cnv_window = null
    cnv_min_size = null
    cnv_germline_prob = null
    known_del = null
    known_ins = null
    known_inv = null
    exclude_list = null
    proxy_normal_bam = null
    proxy_normal_bai = null
    proxy_normal_sampleName = null
    organism_overrides = [
        mouse: [
            genome_build: 'GRCm39',
            ref_fa: params.reference_cache+'/mouse/GRCm39/genome/sequence/ensembl/GRCm39.p0/Mus_musculus.GRCm39.dna.primary_assembly.fa',
            ref_fa_indices: params.reference_cache+'/mouse/GRCm39/genome/indices/ensembl/v105/bwa/Mus_musculus.GRCm39.dna.primary_assembly.fa',
            ref_fa_dict: params.reference_cache+'/mouse/GRCm39/genome/sequence/ensembl/GRCm39.p0/Mus_musculus.GRCm39.dna.primary_assembly.dict',
            combined_reference_set: params.reference_cache+'/mouse/GRCm39/supporting_files/PTA_inputs/combined_ref_set/Mus_musculus.GRCm39.dna.primary_assembly.fa',
            primary_chrom_bed: params.reference_cache+'/mouse/GRCm39/genome/annotation/intervals/Mus_musculus.GRCm39.dna.primary_assembly.bed',
            mismatch_penalty: '8',
            dbSNP: params.reference_cache+'/mouse/GRCm39/genome/annotation/snps_indels/GCA_000001635.9_current_ids.vcf.gz',
            dbSNP_index: params.reference_cache+'/mouse/GRCm39/genome/annotation/snps_indels/GCA_000001635.9_current_ids.vcf.gz.tbi',
            chrom_contigs: params.reference_cache+'/mouse/GRCm39/genome/sequence/ensembl/GRCm39.p0/Mus_musculus.GRCm39.dna.primary_assembly.primaryChr.contig_list',
            chrom_intervals: params.reference_cache+'/mouse/GRCm39/genome/annotation/intervals/GRCm39_calling_intervals/',
            call_val: 50.0,
            ploidy_val: '2',
            excludeIntervalList: params.reference_cache+'/mouse/GRCm39/genome/annotation/intervals/mm39.excluderanges.interval_list',
            intervalListBed: params.reference_cache+'/mouse/GRCm39/supporting_files/capture_kit_files/agilent/v2/S32371113_mouse_exon_V2.mm39.bare.bed',
            lancet_beds_directory: params.reference_cache+'/mouse/GRCm39/genome/annotation/intervals/lancet_chr_beds/',
            delly_exclusion: params.reference_cache+'/mouse/GRCm39/genome/annotation/intervals/GRCm39_gap_delly_exclusion.txt',
            delly_mappability: params.reference_cache+'/mouse/GRCm39/genome/annotation/intervals/mappability/GRCm39.p0.map.gz',
            cnv_window: 10000,
            cnv_min_size: 10000,
            cnv_germline_prob: 0.00100000005,
            callRegions: params.reference_cache+'/mouse/GRCm39/genome/annotation/intervals/GRCm39.callregions.bed.gz',
            strelka_config: params.reference_cache+'/mouse/GRCm39/supporting_files/PTA_inputs/configs/configureStrelkaSomaticWorkflow.py.ini',
            vep_cache_directory: params.reference_cache+'/mouse/GRCm39/genome/annotation/vep_data',
            vep_fasta: params.reference_cache+'/mouse/GRCm39/genome/sequence/ensembl/GRCm39.p0/Mus_musculus.GRCm39.dna.primary_assembly.fa',
            cytoband: params.reference_cache+'/mouse/GRCm39/supporting_files/PTA_inputs/annotations/GRCm38.liftedTo.GRCm39.cytoBand.UCSC.chr.sorted.bed',
            known_del: params.reference_cache+'/mouse/GRCm39/genome/annotation/struct_vars/ferraj_2023_inv_ins_del/variants_freeze5_sv_sym_DEL_mm39_sorted.bed',
            known_ins: params.reference_cache+'/mouse/GRCm39/genome/annotation/struct_vars/ferraj_2023_inv_ins_del/variants_freeze5_sv_sym_INS_mm39_sorted.bed',
            known_inv: params.reference_cache+'/mouse/GRCm39/genome/annotation/struct_vars/ferraj_2023_inv_ins_del/variants_freeze5_sv_sym_INV_mm39_sorted.bed',
            ensemblUniqueBed: params.reference_cache+'/mouse/GRCm39/supporting_files/PTA_inputs/annotations/ensembl_genes_unique_sorted.final.v110.chr.sorted.bed',
            gap: params.reference_cache+'/mouse/GRCm39/genome/annotation/intervals/GRCm39_gap.bed',
            exclude_list: params.reference_cache+'/mouse/GRCm39/genome/annotation/intervals/mm39.excluderanges_cleaned.bed',
            proxy_normal_bam: params.reference_cache+'/mouse/GRCm39/supporting_files/PTA_inputs/C57L_J/C57L_J_dedup.bam',
            proxy_normal_bai: params.reference_cache+'/mouse/GRCm39/supporting_files/PTA_inputs/C57L_J/C57L_J_dedup.bam.bai',
            proxy_normal_sampleName: 'C57L_J',
            mt_contig_name: 'MT',
            mt_fasta: params.reference_cache+'/mouse/GRCm39/genome/sequence/ensembl/GRCm39.p0/mtdna/Mus_musculus.GRCm39.dna.MT.fa',
            mt_genome: params.reference_cache+'/mouse/GRCm39/genome/sequence/ensembl/GRCm39.p0/Mus_musculus.GRCm39.dna.primary_assembly.genome',
            mt_shifted_fasta: params.reference_cache+'/mouse/GRCm39/genome/sequence/ensembl/GRCm39.p0/mtdna/Mus_musculus.GRCm39.dna.MT.shifted8k.fa',
            shift_back_chain: params.reference_cache+'/mouse/GRCm39/genome/sequence/ensembl/GRCm39.p0/mtdna/Mus_musculus.GRCm39.dna.MT.shiftback',
            mt_fasta_index: params.reference_cache+'/mouse/GRCm39/genome/indices/ensembl/v105/bwa/Mus_musculus.GRCm39.dna.MT',
            mt_shifted_fasta_index: params.reference_cache+'/mouse/GRCm39/genome/indices/ensembl/v105/bwa/Mus_musculus.GRCm39.dna.MT.shifted8k',
            exclusion_sites: params.reference_cache+'/mouse/GRCm39/genome/annotation/intervals/Mus_musculus.GRCm39.dna.MT.exclusion.bed',
            max_allele_count: 4,
            non_control_region_interval_list: params.reference_cache+'/mouse/GRCm39/genome/annotation/intervals/non_control_region.chrMT.GRCm39.interval_list',
            control_region_shifted_interval_list: params.reference_cache+'/mouse/GRCm39/genome/annotation/intervals/control_region_shifted.chrMT.GRCm39.interval_list',
            detection_limit: 0.01,
            mapQ: 20,
            baseQ: 20,
            gen_ver: 'GRCm39.105',
            snpEff_config: params.reference_cache+'/mouse/GRCm39/genome/indices/snpEff_5_1d/snpEff.config',
            cosmic: null,
            cosmic_index: null,
            dbNSFP: null
        ]
    ]

    selected_overrides = params.gen_org == 'mouse' ? params.organism_overrides.mouse : [:]
    genome_build = params.selected_overrides.genome_build ?: params.genome_build
    ref_fa = params.selected_overrides.ref_fa ?: params.ref_fa
    ref_fa_indices = params.selected_overrides.ref_fa_indices ?: params.ref_fa_indices
    ref_fa_dict = params.selected_overrides.ref_fa_dict ?: params.ref_fa_dict
    combined_reference_set = params.selected_overrides.combined_reference_set ?: params.combined_reference_set
    primary_chrom_bed = params.selected_overrides.primary_chrom_bed ?: params.primary_chrom_bed
    mismatch_penalty = params.selected_overrides.mismatch_penalty ?: params.mismatch_penalty
    dbSNP = params.selected_overrides.dbSNP ?: params.dbSNP
    dbSNP_index = params.selected_overrides.dbSNP_index ?: params.dbSNP_index
    chrom_contigs = params.selected_overrides.chrom_contigs ?: params.chrom_contigs
    chrom_intervals = params.selected_overrides.chrom_intervals ?: params.chrom_intervals
    call_val = params.selected_overrides.call_val ?: params.call_val
    ploidy_val = params.selected_overrides.ploidy_val ?: params.ploidy_val
    excludeIntervalList = params.selected_overrides.excludeIntervalList ?: params.excludeIntervalList
    intervalListBed = params.selected_overrides.intervalListBed ?: params.intervalListBed
    lancet_beds_directory = params.selected_overrides.lancet_beds_directory ?: params.lancet_beds_directory
    delly_exclusion = params.selected_overrides.delly_exclusion ?: params.delly_exclusion
    delly_mappability = params.selected_overrides.delly_mappability ?: params.delly_mappability
    cnv_window = params.selected_overrides.cnv_window ?: params.cnv_window
    cnv_min_size = params.selected_overrides.cnv_min_size ?: params.cnv_min_size
    cnv_germline_prob = params.selected_overrides.cnv_germline_prob ?: params.cnv_germline_prob
    callRegions = params.selected_overrides.callRegions ?: params.callRegions
    strelka_config = params.selected_overrides.strelka_config ?: params.strelka_config
    vep_cache_directory = params.selected_overrides.vep_cache_directory ?: params.vep_cache_directory
    vep_fasta = params.selected_overrides.vep_fasta ?: params.vep_fasta
    cytoband = params.selected_overrides.cytoband ?: params.cytoband
    known_del = params.selected_overrides.known_del ?: params.known_del
    known_ins = params.selected_overrides.known_ins ?: params.known_ins
    known_inv = params.selected_overrides.known_inv ?: params.known_inv
    ensemblUniqueBed = params.selected_overrides.ensemblUniqueBed ?: params.ensemblUniqueBed
    gap = params.selected_overrides.gap ?: params.gap
    exclude_list = params.selected_overrides.exclude_list ?: params.exclude_list
    proxy_normal_bam = params.selected_overrides.proxy_normal_bam ?: params.proxy_normal_bam
    proxy_normal_bai = params.selected_overrides.proxy_normal_bai ?: params.proxy_normal_bai
    proxy_normal_sampleName = params.selected_overrides.proxy_normal_sampleName ?: params.proxy_normal_sampleName
    mt_contig_name = params.selected_overrides.mt_contig_name ?: params.mt_contig_name
    mt_fasta = params.selected_overrides.mt_fasta ?: params.mt_fasta
    mt_genome = params.selected_overrides.mt_genome ?: params.mt_genome
    mt_shifted_fasta = params.selected_overrides.mt_shifted_fasta ?: params.mt_shifted_fasta
    shift_back_chain = params.selected_overrides.shift_back_chain ?: params.shift_back_chain
    mt_fasta_index = params.selected_overrides.mt_fasta_index ?: params.mt_fasta_index
    mt_shifted_fasta_index = params.selected_overrides.mt_shifted_fasta_index ?: params.mt_shifted_fasta_index
    exclusion_sites = params.selected_overrides.exclusion_sites ?: params.exclusion_sites
    max_allele_count = params.selected_overrides.max_allele_count ?: params.max_allele_count
    non_control_region_interval_list = params.selected_overrides.non_control_region_interval_list ?: params.non_control_region_interval_list
    control_region_shifted_interval_list = params.selected_overrides.control_region_shifted_interval_list ?: params.control_region_shifted_interval_list
    detection_limit = params.selected_overrides.detection_limit ?: params.detection_limit
    mapQ = params.selected_overrides.mapQ ?: params.mapQ
    baseQ = params.selected_overrides.baseQ ?: params.baseQ
    gen_ver = params.selected_overrides.gen_ver ?: params.gen_ver
    snpEff_config = params.selected_overrides.snpEff_config ?: params.snpEff_config
    cosmic = params.selected_overrides.cosmic ?: params.cosmic
    cosmic_index = params.selected_overrides.cosmic_index ?: params.cosmic_index
    dbNSFP = params.selected_overrides.dbNSFP ?: params.dbNSFP
}
