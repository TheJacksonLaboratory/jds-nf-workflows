//====================  Nextflow/Container Config  ==========

manifest {
    name = "gbrs"
    description = 'Pipeline for Running GBRS'
}

params {
    // Shared params
    gen_org = params.gen_org ?: 'mouse'
    extension = '.fastq.gz'
    pattern = "*_R{1,2}*"
    genome_build = params.genome_build ?: 'GRCm39'
    read_type = 'PE' // 'SE'
    concat_lanes = false
    concat_sampleID_delim = '_' // only used if concat_lanes = true
    concat_sampleID_positions = 1 // only used if concat_lanes = true
    csv_input = null
    download_data = null

    sample_generation = null // 0-100 possible values here. 
    sample_sex = null // 'F' | 'M'

    // Reference fasta
    bowtie_index = null
    transcripts_info = null
    gbrs_strain_list = "A,B,C,D,E,F,G,H"

    gene2transcript_csv = null
    full_transcript_info = null

    emase_model = 4  
    // [ choices: 1,2,3,4 ]
    //   1: reads are apportioned among genes first,
    //       then between alleles, and then among isoforms.
    //   2: reads are apportioned among genes first,
    //       then among isoforms, and then between alleles.
    //   3: reads are apportioned among genes first,
    //       then among each isoform-allele combination
    //       which are treated equally.
    //   4: assumes no hierarchy and multi-reads are
    //       apportioned equally among genes, isoforms, and
    //       alleles


    // GBRS 
    emission_prob_avecs = null
    trans_prob_dir = null
    gene_position_file = null
    genotype_grid = null
    founder_hex_colors = null

    base_ref_index_fai = null

    gbrs_expression_threshold = 1.5 // default is 1.5. The level of expression in a sample required to include the gene. 
    gbrs_sigma = 0.12 // GBRS scaling factor. Default should be used unless you understand the parameter. 

    reference_defaults = [
        GRCm39: [
            bowtie_index: params.reference_cache+'/mouse/GRCm39/transcriptome/indices/imputed/rel_2112_v8/bowtie/bowtie.transcripts',
            transcripts_info: params.reference_cache+'/mouse/GRCm39/supporting_files/emase_gbrs/rel_2112_v8/emase.fullTranscripts.info',
            gene2transcript_csv: params.reference_cache+'/mouse/GRCm39/supporting_files/emase_gbrs/rel_2112_v8/emase.gene2transcripts.tsv',
            full_transcript_info: params.reference_cache+'/mouse/GRCm39/supporting_files/emase_gbrs/rel_2112_v8/emase.pooled.fullTranscripts.info',
            emission_prob_avecs: params.reference_cache+'/mouse/GRCm39/supporting_files/emase_gbrs/rel_2112_v8/gbrs_emissions_all_tissues.avecs.npz',
            trans_prob_dir: params.reference_cache+'/mouse/GRCm39/supporting_files/emase_gbrs/rel_2112_v8/transition_probabilities',
            gene_position_file: params.reference_cache+'/mouse/GRCm39/supporting_files/emase_gbrs/rel_2112_v8/ref.gene_pos.ordered_ensBuild_105.npz',
            genotype_grid: params.reference_cache+'/mouse/GRCm39/supporting_files/emase_gbrs/rel_2112_v8/ref.genome_grid.GRCm39.tsv',
            founder_hex_colors: params.reference_cache+'/mouse/GRCm39/supporting_files/emase_gbrs/rel_2112_v8/founder.hexcolor.info',
            base_ref_index_fai: params.reference_cache+'/mouse/GRCm39/genome/sequence/ensembl/v105/Mus_musculus.GRCm39.dna.primary_assembly.fa.fai'
        ],
        GRCm38: [
            bowtie_index: params.reference_cache+'/mouse/GRCm38/supporting_files/emase_gbrs/rel_1505_v5/transcript_reference/transcripts',
            transcripts_info: params.reference_cache+'/mouse/GRCm38/supporting_files/emase_gbrs/rel_1505_v5/ref.transcripts.info',
            gene2transcript_csv: params.reference_cache+'/mouse/GRCm38/supporting_files/emase_gbrs/rel_1505_v5/ref.gene2transcripts.tsv',
            full_transcript_info: params.reference_cache+'/mouse/GRCm38/supporting_files/emase_gbrs/rel_1505_v5/gbrs.hybridized.targets.info',
            emission_prob_avecs: params.reference_cache+'/mouse/GRCm38/supporting_files/emase_gbrs/rel_1505_v5/avecs.npz',
            trans_prob_dir: params.reference_cache+'/mouse/GRCm38/supporting_files/emase_gbrs/rel_1505_v5/tranprob',
            gene_position_file: params.reference_cache+'/mouse/GRCm38/supporting_files/emase_gbrs/rel_1505_v5/ref.gene_pos.ordered_0.1.6.npz',
            genotype_grid: params.reference_cache+'/mouse/GRCm38/supporting_files/emase_gbrs/rel_1505_v5/ref.genome_grid.69k.noYnoMT_KBEdit.txt',
            founder_hex_colors: params.reference_cache+'/mouse/GRCm38/supporting_files/emase_gbrs/rel_1505_v5/founder.hexcolor.info',
            base_ref_index_fai: params.reference_cache+'/mouse/GRCm38/supporting_files/emase_gbrs/rel_1505_v5/ref.fa.fai'
        ]
    ]

    selected_defaults = params.reference_defaults[params.genome_build]
    bowtie_index = params.selected_defaults.bowtie_index
    transcripts_info = params.selected_defaults.transcripts_info
    gene2transcript_csv = params.selected_defaults.gene2transcript_csv
    full_transcript_info = params.selected_defaults.full_transcript_info
    emission_prob_avecs = params.selected_defaults.emission_prob_avecs
    trans_prob_dir = params.selected_defaults.trans_prob_dir
    gene_position_file = params.selected_defaults.gene_position_file
    genotype_grid = params.selected_defaults.genotype_grid
    founder_hex_colors = params.selected_defaults.founder_hex_colors
    base_ref_index_fai = params.selected_defaults.base_ref_index_fai

}
