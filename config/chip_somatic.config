//====================  Nextflow/Container Config  ==========

manifest {
    name = "chip_somatic"
    description = 'Tumor-only somatic calling for a targeted clonal hematopoiesis (CHIP) gene panel, mouse + human. Population-based germline-resource + panel-of-normals filtering (no matched normal, no proxy-normal substitution) — see notes/germline_resource_design.md.'
}

params {
  // Shared params
  gen_org = params.gen_org ?: 'human'
  genome_build = params.genome_build ?: 'GRCh38'
  read_type = 'PE'
  csv_input = null

  multiqc_config = "${projectDir}/bin/shared/multiqc/chip_somatic_multiqc.yaml"

  // FASTP parameters
  quality_phred = 15
  unqualified_perc = 40
  detect_adapter_for_pe = false
  trim_poly_g = false
  trim_poly_x = false
  poly_x_min_len = 10

  // BWA param
  mismatch_penalty = "8"

  // Reference fasta -- human default; mouse overridden below
  ref_fa = params.reference_cache+'/human/GRCh38/genome/sequence/gatk/Homo_sapiens_assembly38.fasta'
  ref_fa_indices = params.reference_cache+'/human/GRCh38/genome/indices/gatk/bwa/Homo_sapiens_assembly38.fasta'

  // bwa-mem2 index (fgbio UMI chain, both species). Resolved explicitly per species,
  // not via selected_overrides + `?:`, so a missing mouse value can never fall back
  // to the human index. Mouse index built 2026-09-28 (bwa-mem2 2.2.1, see the
  // README.txt next to it); param_log() checks the index exists at startup.
  ref_fa_bwamem2_indices = params.gen_org == 'mouse' ?
      params.reference_cache+'/mouse/GRCm39/genome/indices/ensembl/v105/bwa2/Mus_musculus.GRCm39.dna.primary_assembly.fa' :
      params.reference_cache+'/human/GRCh38/genome/indices/gatk/bwa2/Homo_sapiens_assembly38.fasta'

  // UMI/duplex-consensus dedup chain (Twist Bioscience UMI adapter system --
  // DOC-001337/DOC-001506; see notes/milestones.md open item 6 for the full
  // rationale and pipeline provenance). Replaces plain PICARD_MARKDUPLICATES
  // for human -- the panel's real library prep uses inline dual UMIs, so
  // extraction is a correctness requirement, not an optional feature.
  umi_read_structure = "5M2S+T 5M2S+T" // 5bp UMI + 2bp skip, same on both mates

  // Duplex (both-strand-confirmed error correction) vs. molecular (single-
  // strand consensus, no duplex requirement) consensus calling -- both
  // ported from the same reference pipeline (5baseTAPS's own
  // params.duplex_seq toggle). GroupReadsByUmi's strategy follows the same
  // switch there (Paired needs the A/B duplex structure; Adjacency doesn't).
  duplex_seq = true

  // params.duplex_seq itself is NOT safe to use in an `if`/ternary anywhere
  // outside this params{} block. Verified directly (not assumed): a CLI
  // override (`--duplex_seq false`) makes params.duplex_seq the STRING
  // "false" -- Nextflow re-applies the raw CLI value on top of ANY
  // in-block reassignment to that same param name once config parsing
  // finishes, so attempting to coerce `duplex_seq` itself back to a real
  // boolean here doesn't stick by the time other files read it. And plain
  // Groovy truthiness treats any non-empty string -- "false" included --
  // as true in a runtime `if()`, so an uncoerced read silently always
  // takes the duplex branch regardless of what was passed. Confirmed the
  // hard way: this ran CallDuplexConsensusReads on Adjacency-grouped input
  // (no /A or /B MI-tag suffix to parse) and crashed inside fgbio's
  // DuplexConsensusCaller. A *different*-named derived param does persist
  // correctly -- use `params.duplex_seq_bool` everywhere else in this
  // workflow's logic (subworkflows, modules) instead of `params.duplex_seq`.
  duplex_seq_bool = (params.duplex_seq == null ? true : params.duplex_seq).toString().toBoolean()
  groupreadsbyumi_strategy = params.groupreadsbyumi_strategy ?: (params.duplex_seq_bool ? "Paired" : "Adjacency")
  groupreadsbyumi_edits = 1 // tolerate 1 sequencing error per UMI (Hamming distance 2 by design)

  // --call_min_reads' expected FORMAT differs by mode -- not interchangeable:
  //   duplex_seq=true:  1-3 space-separated ints (final / single-strand-1 /
  //     single-strand-2 minimums). Default "2 1 1" is Twist's recommendation
  //     for error-correction/low-frequency variant calling (>=1 supporting
  //     read from each strand); their separate "1 1 0" is for pure duplicate
  //     *counting* use cases (e.g. RNA-seq), not this one.
  //   duplex_seq=false: a single int (minimum raw reads per consensus base).
  //     fgbio's own CallMolecularConsensusReads --help: "--min-reads=1 is
  //     appropriate" to retain singletons while still consensus-calling true
  //     duplicate families.
  // Left overridable at invocation regardless of mode.
  call_min_reads = "2 1 1"
  call_min_baseq = 30
  filter_max_base_error_rate = 0.1 // fgbio FilterConsensusReads' own tool default

  // CHIP panel target/bait intervals -- PLACEHOLDERS. The panel-scoping interval
  // list (converting the project's Consensus BED to a padded interval list) is
  // not built yet -- tracked separately, see notes/jds_pipeline_architecture.md
  // "Panel scoping (not yet built)". These paths point at where that output will
  // land once built; until then, running chip_somatic will fail at
  // PICARD_COLLECTHSMETRICS / GATK_MUTECT2's `-L` with a file-not-found error,
  // which is intentional -- there is no valid stand-in panel to substitute.
  // GATK default (50) is tuned for typical WGS/WES depth, not this panel's
  // 5000-10000x+ design target -- disabled by default (0), overridable.
  max_reads_per_alignment_start = 0

  // Mutect2 candidate-emission threshold (--tumor-lod-to-emit). GATK's own
  // default (3.0, i.e. 1000:1 odds) is tuned for WGS/WES depth/noise levels;
  // at this panel's design depth, a real low-VAF/low-molecule-count driver
  // (e.g. a handful of true CHIP-clone molecules) can fail to clear that bar
  // and never even reach FilterMutectCalls for review. Lowered so more
  // candidates get emitted; FilterMutectCalls' own statistical filter (tuned
  // via f_score_beta below) still does the real PASS/weak_evidence call.
  // Starting point, not a validated-optimal value -- overridable.
  tumor_lod_to_emit = 1.0

  // FilterMutectCalls' recall/precision tradeoff (--f-score-beta). GATK's
  // default (1.0) weights both equally; CHIP calling explicitly wants rare
  // low-VAF candidates surfaced for human review rather than silently
  // dropped, so this is raised to weight recall higher. Starting point, not
  // a validated-optimal value -- overridable.
  f_score_beta = 2.0

  // Picard CollectHsMetrics' per-base coverage histogram cap (COVERAGE_CAP).
  // Picard's own default (200) is tuned for WGS/WES depth -- at this panel's
  // design depth it silently truncates MEDIAN_TARGET_COVERAGE and every
  // PCT_TARGET_BASES_*X column above 200x (MEAN_TARGET_COVERAGE is computed
  // from raw totals, not the capped histogram, so it isn't affected).
  // Comfortably above the panel's raw design depth -- overridable.
  coverage_cap = 20000

  // Panel intervals are REQUIRED (no default, both species) until the vendors'
  // final probe files exist; each probe set (Twist, TEQUILA) will need its own.
  // param_log() stops the run at startup if any is missing or not found.
  target_gatk = null
  target_picard = null
  bait_picard = null

  // Germline-resource (Mutect2 --germline-resource) -- human default.
  // NOTE: the underlying Mutect2 module (gatk_mutect2_tumorOnly.nf, reused
  // unmodified) reads `params.gnomad_ref` literally -- that name is accurate
  // for human (it really is gnomAD) but would be misleading for mouse (where
  // the value is a strain-background resource, not gnomAD). So this config
  // defines the accurately-named `germline_resource_vcf` throughout, and
  // aliases it to `gnomad_ref` as the very last line of this file, purely to
  // satisfy the existing module's param name.
  germline_resource_vcf = params.reference_cache+'/human/GRCh38/genome/annotation/snps_indels/af-only-gnomad.hg38.vcf.gz'

  // Panel-of-normals (Mutect2 --panel-of-normals) -- human default: the
  // existing WES PoN, a real public resource (not built from this panel's own
  // chemistry, but a reasonable starting default per GATK's own guidance).
  pon_ref = params.reference_cache+'/human/GRCh38/genome/annotation/snps_indels/1000g_pon.hg38.vcf.gz'

  // Contamination-estimation resource (GATK GetPileupSummaries/CalculateContamination)
  // -- human default: existing WES resource.
  contam_ref = params.reference_cache+'/human/GRCh38/genome/annotation/snps_indels/small_exac_common_3.hg38.vcf.gz'

  genotype_pon = true
  genotype_germline = true

  organism_overrides = [
    mouse: [
      genome_build: 'GRCm39',
      ref_fa: params.reference_cache+'/mouse/GRCm39/genome/sequence/ensembl/GRCm39.p0/Mus_musculus.GRCm39.dna.primary_assembly.fa',
      ref_fa_indices: params.reference_cache+'/mouse/GRCm39/genome/indices/ensembl/v105/bwa/Mus_musculus.GRCm39.dna.primary_assembly.fa',

      // Deliberately safe default -- an empty/near-empty B6 placeholder VCF,
      // NOT UM-HET3. If a run is mistakenly left on this default, the failure
      // direction is "extra UM-HET3 founder variants show up as unfiltered
      // candidates to review" (annoying, not wrong) rather than "a real novel
      // B6 variant gets wrongly filtered out" (a missed true finding). Override
      // directly with a file path (e.g. the UM-HET3 germline-resource) at
      // invocation time when running UM-HET3 samples -- there is no named
      // `--germline-background` selector; project-specific resource paths are
      // supplied here directly, not baked into this shared repo's config.
      // Shipped header-only placeholder (zero sites, GRCm39 contigs). The planned
      // omics_share .../snps_indels/chip/b6_germline_resource.vcf.gz was never
      // created (found 2026-09-28), so Mutect2 would have failed on the default.
      germline_resource_vcf: "${projectDir}/assets/chip_somatic/empty_germline_resource_mm39.vcf.gz",

      // Content-free placeholder (header-only, zero real sites) -- shipped as
      // a static asset since, unlike germline_resource_vcf above, there is no
      // "wrong choice" risk to guard against here. Swap for a real mouse PoN,
      // built from real CHIP-assay data, once it exists.
      pon_ref: "${projectDir}/assets/chip_somatic/empty_pon.vcf.gz"
    ]
  ]

  selected_overrides = params.gen_org == 'mouse' ? params.organism_overrides.mouse : [:]
  genome_build = params.selected_overrides.genome_build ?: params.genome_build
  ref_fa = params.selected_overrides.ref_fa ?: params.ref_fa
  ref_fa_indices = params.selected_overrides.ref_fa_indices ?: params.ref_fa_indices
  target_gatk = params.selected_overrides.target_gatk ?: params.target_gatk
  target_picard = params.selected_overrides.target_picard ?: params.target_picard
  bait_picard = params.selected_overrides.bait_picard ?: params.bait_picard
  germline_resource_vcf = params.selected_overrides.germline_resource_vcf ?: params.germline_resource_vcf
  pon_ref = params.selected_overrides.pon_ref ?: params.pon_ref

  // NOTE: genotype_pon and contam_ref are NOT resolved via the `selected_overrides
  // ?: ` pattern above -- mouse's correct values are `false` and `null`
  // respectively, and Groovy's `?:` treats both as falsy, which would silently
  // fall through to the human default instead of applying the override. Resolved
  // explicitly instead:
  genotype_pon = params.gen_org == 'mouse' ? false : true // mouse: no real PoN sites to genotype yet (placeholder is content-free)
  contam_ref = params.gen_org == 'mouse' ? null : params.contam_ref // mouse: contamination estimation skipped entirely (B6: biologically inapplicable; UM-HET3: buildable fast-follow, not built yet)

  // Annotation (subworkflows/chip_annotation.nf), added 2026-09-29 -- reuses the
  // same resources --workflow somatic_wes already uses (verified present in
  // omics_share), via new chip-specific modules (WES's own modules are untouched;
  // their publishDir/enabled logic is tuned to WES's file-naming, not ours).
  // dbSNP + COSMIC (ID annotation) and dbNSFP (in-silico deleteriousness scores)
  // are human-only resources -- explicitly null for mouse (not resolved via the
  // selected_overrides `?:` pattern above, same reason as genotype_pon/contam_ref:
  // null is falsy in Groovy and would silently fall through to the human path).
  // A mouse-build dbSNP-like resource exists (MGP-based, GRCm38) but was NOT
  // wired in: it's on GRCm38 coordinates, not our GRCm39 reference, and would
  // silently misannotate every position without a liftover step that doesn't
  // exist yet. COSMIC and dbNSFP have no mouse equivalent at all (COSMIC
  // catalogs human cancer only; dbNSFP is built from human-genome predictors).
  dbSNP = params.gen_org == 'mouse' ? null : params.reference_cache+'/human/GRCh38/genome/annotation/snps_indels/dbsnp_151.vcf.gz'
  dbSNP_index = params.gen_org == 'mouse' ? null : params.reference_cache+'/human/GRCh38/genome/annotation/snps_indels/dbsnp_151.vcf.gz.tbi'
  cosmic = params.gen_org == 'mouse' ? null : params.reference_cache+'/human/GRCh38/genome/annotation/function/COSMICv95_Coding_Noncoding.gatk_formatted.vcf.gz'
  cosmic_index = params.gen_org == 'mouse' ? null : params.reference_cache+'/human/GRCh38/genome/annotation/function/COSMICv95_Coding_Noncoding.gatk_formatted.vcf.gz.tbi'
  // dbNSFP: the bare-chromosome-name copy (made 2026-10-03 from the gatk_formatted
  // file, "chr" prefix stripped, re-bgzipped, own .tbi/.data_types). SnpSift 5.1d
  // `dbnsfp` strips "chr" from the VCF's contig names before looking them up, so
  // the chr-prefixed original (still used by somatic_wes, untouched) matched
  // nothing: 0 annotated entries, silently. The VCFs themselves keep their chr names.
  dbNSFP = params.gen_org == 'mouse' ? null : params.reference_cache+'/human/GRCh38/genome/annotation/function/dbNSFP4.2a.gatk_formatted.nochr.txt.gz'

  // SnpEff DOES have a real GRCm39 database, so consequence/gene annotation
  // (unlike dbSNP/COSMIC/dbNSFP above) runs for both species.
  gen_ver = params.gen_org == 'mouse' ? 'GRCm39.105' : 'hg38'
  snpEff_config = params.gen_org == 'mouse' ?
      params.reference_cache+'/mouse/GRCm39/genome/indices/snpEff_5_1d/snpEff.config' :
      params.reference_cache+'/human/GRCh38/genome/indices/snpEff_5_1/snpEff.config'

  // Alias for the existing, unmodified gatk_mutect2_tumorOnly.nf module, which
  // reads params.gnomad_ref literally -- see the comment on germline_resource_vcf
  // above for why this file defines the accurately-named param and aliases it
  // here rather than the other way around.
  gnomad_ref = params.germline_resource_vcf
}
