params {
    csv_input = "${projectDir}/examples/messages.csv"
    pubdir = "${projectDir}/results"
}

workDir = "${projectDir}/work"

manifest {
    name = 'nextflow-training-example'
    description = 'A minimal DSL2 workflow for learning the repository structure'
    mainScript = 'main.nf'
}

process {
    executor = 'local'
    cpus = 1
    memory = '256 MB'
    time = '5m'

    withName: SUMMARIZE_MESSAGE {
        publishDir = [path: params.pubdir, mode: 'copy', overwrite: true]
    }

    withName: GATHER_SUMMARIES {
        publishDir = [path: params.pubdir, mode: 'copy', overwrite: true]
    }
}

profiles {
    local {
        process.executor = 'local'
    }
}